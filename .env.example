# This is an example .env file for the Near Merch Store project. Copy this file to .env and fill in the required values.

# BetterAuth (https://www.better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# PostgreSQL (docker-compose)
API_DATABASE_URL=postgres://postgres:postgres@localhost:5433/api

# Turso (host auth)
HOST_DATABASE_AUTH_TOKEN=
HOST_DATABASE_URL=

# Printful (https://printful.com/)
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# Lulu (https://www.lulu.com/developers)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# Ping (https://pay.pingpay,io/dashboard)
PING_API_KEY=
PING_WEBHOOK_SECRET=

# HMAC secret for POST /api/webhooks/manual
MANUAL_WEBHOOK_SECRET=

# x402. Settlement is HTTP 402 on POST /orders/{id}/pay, not a hosted checkout.
# X402_ENABLED is the master switch (default off: nothing x402 is mounted).
# Default network is eip155:8453 (Base). Use eip155:84532 + https://x402.org/facilitator for Sepolia.
X402_ENABLED=
X402_PAY_TO_ADDRESS=
X402_FACILITATOR_URL=
X402_NETWORK=
X402_HOST_SECRET=
# NEAR Intents via Ping Agent Pay (issue #238): pay from any chain/asset Ping offers; the store
# receives USDC on NEAR at the recipient set in the Ping dashboard (Agent Pay settings).
# On by default once X402_ENABLED is on; set X402_INTENTS_ENABLED=false for Base exact only.
# Base exact (eip3009) above is only offered when X402_PAY_TO_ADDRESS is set (dev / Base Sepolia).
# FACILITATOR_URL defaults to https://pay.pingpay.io/agentpay/x402 (staging: https://staging.pingpay.io/agentpay/x402).
# FACILITATOR_API_KEY is the Ping API key (X-Api-Key); falls back to PING_API_KEY for a pingpay.io URL.
# ORIGINS is an optional allow-list, e.g. ["eip155:8453",{"network":"eip155:42161","asset":"0xaf88d065e77c8cC2239327C5EDb3A432268e5831"}]
X402_INTENTS_ENABLED=
X402_INTENTS_FACILITATOR_URL=
X402_INTENTS_FACILITATOR_API_KEY=
X402_INTENTS_ORIGINS=

# Resend (https://resend.com/) — email delivery for manual fulfillment notifications
RESEND_API_KEY=
MANUAL_FULFILLMENT_FROM_EMAIL=orders@nearmerch.com

# PostHog (https://posthog.com/) — public key, safe for client-side
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Storage (R2 or S3)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_REGION=us-east-1
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
