# This is an example .env file for the Near Merch Store project. Copy this file to .env and fill in the required values.

# BetterAuth (https://www.better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# PostgreSQL (docker-compose)
API_DATABASE_URL=postgres://postgres:postgres@localhost:5433/api

# Turso (host auth)
HOST_DATABASE_AUTH_TOKEN=
HOST_DATABASE_URL=

# Printful (https://printful.com/)
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# Lulu (https://www.lulu.com/developers)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# Ping (https://pay.pingpay,io/dashboard)
PING_API_KEY=
PING_WEBHOOK_SECRET=

# HMAC secret for POST /api/webhooks/manual
MANUAL_WEBHOOK_SECRET=

# x402 (USDC on Base). Settlement is HTTP 402 on POST /orders/{id}/pay, not a hosted checkout.
# Default network is eip155:8453 (Base). Use eip155:84532 + https://x402.org/facilitator for Sepolia.
X402_ENABLED=
X402_PAY_TO_ADDRESS=
X402_FACILITATOR_URL=
X402_NETWORK=
X402_HOST_SECRET=
# Phase 2: pay from other chains through NEAR Intents (issue #238). Off by default.
# Needs X402_ENABLED, Base mainnet, a near-intents facilitator and at least one origin, e.g.
# X402_INTENTS_ORIGINS=[{"network":"eip155:42161","asset":"0xaf88d065e77c8cC2239327C5EDb3A432268e5831","decimals":6,"maxTimeoutSeconds":300,"usdPegged":true}]
# X402_INTENTS_FEE_MODE=out_of_band (default) or app_fees (splits as 1Click appFees, <= 500 bps total; only with a facilitator that honours merchant appFees).
X402_INTENTS_ENABLED=
X402_INTENTS_FACILITATOR_URL=
X402_INTENTS_FACILITATOR_API_KEY=
X402_INTENTS_ORIGINS=
X402_INTENTS_FEE_MODE=

# Resend (https://resend.com/) — email delivery for manual fulfillment notifications
RESEND_API_KEY=
MANUAL_FULFILLMENT_FROM_EMAIL=orders@nearmerch.com

# PostHog (https://posthog.com/) — public key, safe for client-side
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Storage (R2 or S3)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_REGION=us-east-1
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
